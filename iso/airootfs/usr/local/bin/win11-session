#!/usr/bin/env bash
# Win11wm live session launcher

export WIN11WM_ASSETS=/opt/win11wm/assets
export PATH=/usr/local/bin:/usr/bin:/bin

# user dirs
command -v xdg-user-dirs-update >/dev/null && xdg-user-dirs-update || true

# start polkit
if command -v /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
elif command -v polkit-agent-helper >/dev/null; then
    : # polkitd usually runs
fi

# dbus
if [ -x /usr/bin/dbus-launch ]; then
    eval "$(dbus-launch --exit-with-session --sh-syntax)"
fi

# use the bundled session (our own WM). win11wm fills the X root by itself and
# takes no fullscreen flag; only pass through caller args. Scrub any inherited
# Wayland vars so spawned X11 clients talk to this server, not a host compositor.
exec env -u WAYLAND_DISPLAY -u XDG_SESSION_TYPE /opt/win11wm/win11wm "$@"
