using Gtk 4.0;
using Adw 1;

menu app_menu {
  section {
    item {
      label: _("New _Window");
      action: "app.clone-window";
      verb-icon: "window-new-symbolic";
    }

    item {
      label: _("New _Tab");
      action: "win.new-tab";
      verb-icon: "tab-new-symbolic";
    }
  }

  section undo_redo_section {
    /* Note: This section is often recreated by undo_manager_changed() to
     * change the labels of the actions. If you change anything here,
     * remember to change in the code as well.
     */
    item {
      label: _("_Undo");
      action: "win.undo";
    }

    item {
      label: _("_Redo");
      action: "win.redo";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Help");
      action: "app.help";
    }

    item {
      label: _("_About Files");
      action: "app.about";
    }
  }
}

menu tab_menu_model {
  section {
    item {
      label: _("_New Tab");
      action: "win.new-tab";
    }

    item {
      label: _("Re_store Closed Tab");
      action: "win.restore-tab";
    }
  }

  section {
    item {
      label: _("Move Tab to New _Window");
      action: "win.tab-move-new-window";
    }

    item {
      /* Translators: use “Move Tab _Right” for RTL languages */
      label: _("Move Tab _Left");
      action: "win.tab-move-left";
    }

    item {
      /* Translators: use “Move Tab _Left” for RTL languages */
      label: _("Move Tab _Right");
      action: "win.tab-move-right";
    }
  }

  section {
    item {
      label: _("_Close Tab");
      action: "win.close-current-view";
    }

    item {
      label: _("Close _Other Tabs");
      action: "win.close-other-tabs";
    }
  }
}

/* Overflow ("...") menu of the command bar.  Windows 11 keeps the command bar
 * focused on the primary file actions and hides the rest behind the "...". */
menu command_bar_menu {
  section {
    item {
      label: _("Select _All");
      action: "view.select-all";
      accel: "<control>a";
    }

    item {
      label: _("P_roperties");
      action: "view.properties";
      accel: "<alt>Return";
    }
  }
}

/* Dropdown of the "New" split button, as in the Windows 11 command bar. */
menu new_items_menu {
  section {
    item {
      label: _("New _Folder");
      action: "view.new-folder";
    }

    item {
      label: _("New _Shortcut");
      action: "view.create-link";
      hidden-when: "action-disabled";
    }
  }
}

template $NautilusWindow: Adw.ApplicationWindow {
  height-request: 380;
  show-menubar: false;
  title: bind template.active-slot as <$NautilusWindowSlot>.title;

  styles [
    "view",
  ]

  $NautilusShortcutManager {
    child: Adw.ToastOverlay toast_overlay {
      child: Adw.OverlaySplitView split_view {
        enable-show-gesture: false;
        enable-hide-gesture: false;
        max-sidebar-width: 240;
        sidebar-width-unit: px;
        sidebar-width-fraction: 0.2;

        sidebar: Adw.ToolbarView {
          reveal-bottom-bars: bind progress_indicator.reveal;

          [top]
          Adw.HeaderBar {
            [start]
            ToggleButton {
              tooltip-text: _("Search Everywhere");
              action-name: "slot.search-global";
              icon-name: "edit-find-symbolic";
            }

            title-widget: Adw.WindowTitle {
              title: _("Files");
            };

            [end]
            MenuButton {
              tooltip-text: _("Main Menu");
              icon-name: "open-menu-symbolic";
              menu-model: app_menu;
            }
          }

          [bottom]
          Box {
            styles [
              "toolbar",
            ]

            $NautilusProgressIndicator progress_indicator {}
          }

          content: $NautilusSidebar places_sidebar {
            vexpand: true;
            window-slot: bind template.active-slot;
          };
        };

        content: Adw.ToolbarView {
          /* Windows 11 puts the tabs and the caption buttons (minimize /
           * maximize / close) on the same top row, with the caption buttons
           * flush against the top-right corner. Adw.TabBar only takes a single
           * end action widget, so the tab strip and a standalone
           * Gtk.WindowControls share this row instead. */
          [top]
          Box tab_row {
            styles [
              "win11-title-bar",
            ]

            orientation: horizontal;

            Adw.TabBar tab_bar {
              view: tab_view;
              autohide: false;
              hexpand: true;

              end-action-widget: Button new_tab_button {
                action-name: "win.new-tab";
                icon-name: "tab-new-symbolic";
                tooltip-text: _("New Tab");
                valign: center;
                halign: center;
              };
            }

            WindowControls window_controls {
              side: end;
              valign: center;
            }
          }

          [top]
          $NautilusToolbar toolbar {
            show-view-controls: true;
            show-history-controls: true;
            sidebar-button-active: bind split_view.show-sidebar bidirectional;
            window-slot: bind template.active-slot;
          }

          [top]
          Box command_bar {
            styles [
              "toolbar",
              "nautilus-command-bar",
            ]

            orientation: horizontal;
            spacing: 2;

            /* Windows 11's "New" button opens the template menu. */
            MenuButton new_button {
              tooltip-text: _("New");
              menu-model: new_items_menu;
              valign: center;

              child: Box {
                spacing: 6;
                Image { icon-name: "folder-new-symbolic"; }
                Label { label: _("New"); }
                Image { icon-name: "pan-down-symbolic"; }
              };
            }

            Button cut_button {
              action-name: "view.cut";

              Box {
                spacing: 6;
                Image { icon-name: "edit-cut-symbolic"; }
                Label { label: _("Cut"); }
              }
            }

            Button copy_button {
              action-name: "view.copy";

              Box {
                spacing: 6;
                Image { icon-name: "edit-copy-symbolic"; }
                Label { label: _("Copy"); }
              }
            }

            Button paste_button {
              action-name: "view.paste";

              Box {
                spacing: 6;
                Image { icon-name: "edit-paste-symbolic"; }
                Label { label: _("Paste"); }
              }
            }

            Button rename_button {
              action-name: "view.rename";

              Box {
                spacing: 6;
                Image { icon-name: "document-edit-symbolic"; }
                Label { label: _("Rename"); }
              }
            }

            Button delete_button {
              action-name: "view.move-to-trash";

              Box {
                spacing: 6;
                Image { icon-name: "user-trash-symbolic"; }
                Label { label: _("Delete"); }
              }
            }

            Box { hexpand: true; }

            /* Sort and View dropdowns. Their menus are built in code because
             * they need typed action targets (the sort criterion and the view
             * mode), which Blueprint cannot express. */
            MenuButton sort_button {
              tooltip-text: _("Sort");
              valign: center;

              child: Box {
                spacing: 4;
                Label { label: _("Sort"); }
                Image { icon-name: "pan-down-symbolic"; }
              };
            }

            MenuButton view_button {
              tooltip-text: _("View");
              valign: center;

              child: Box {
                spacing: 4;
                Label { label: _("View"); }
                Image { icon-name: "pan-down-symbolic"; }
              };
            }

            /* The "..." button holds the secondary commands, like the
             * Windows 11 command bar does. */
            MenuButton more_button {
              icon-name: "view-more-symbolic";
              tooltip-text: _("See more");
              menu-model: command_bar_menu;
              valign: center;
            }
          }

          content: Adw.TabView tab_view {
            menu-model: tab_menu_model;
          };

          [bottom]
          $NautilusNetworkAddressBar network_address_bar {
            visible: false;
          }

          [bottom]
          ActionBar action_bar {
            revealed: false;

            [start]
            $NautilusHistoryControls {
              window-slot: bind template.active-slot;
            }

            [end]
            $NautilusViewControls {
              window-slot: bind template.active-slot;
            }
          }
        };
      };
    };
  }

  Adw.Breakpoint {
    condition ("max-width: 682sp")

    setters {
      split_view.collapsed: true;
      split_view.enable-show-gesture: true;
      split_view.enable-hide-gesture: true;
      toolbar.show-sidebar-button: true;
      toolbar.show-view-controls: false;
      toolbar.show-history-controls: false;
      action_bar.revealed: true;
      progress_indicator.popover-position: 2;
    }
  }
}
